# ─────────────────────────────────────────────────────────────────────────────
# INTELLICATH — Environment Variables
# Copy this file to .env for local development, or set these as Vercel env vars.
# Never commit .env or serviceAccountKey.json to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── API Authentication (SEC-1) ────────────────────────────────────────────────
# Generate a strong random secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# All API requests must include the header:  X-Api-Key: <this value>
# Leave unset to disable auth (local dev only).
API_SECRET_KEY=

# ── Firebase / Firestore (required) ──────────────────────────────────────────
# Option 1 (Vercel): Paste the entire service account JSON as a single line.
# Option 2 (local):  Place serviceAccountKey.json in the project root.
# Use a least-privilege service account with only roles/datastore.user (SEC-12).
FIREBASE_SERVICE_ACCOUNT=

# ── ML Model Integrity Hashes (SEC-2) ────────────────────────────────────────
# After training or updating models, regenerate with:
#   python -c "import hashlib; print(hashlib.sha256(open('models/decision_tree.pkl','rb').read()).hexdigest())"
#   python -c "import hashlib; print(hashlib.sha256(open('models/scaler.pkl','rb').read()).hexdigest())"
# Leave blank to skip verification (not recommended in production).
MODEL_HASH_TREE=a2be8365e61a3a157d1e79f5d3057b1e6d4134feeb5f98f12a6f2e29508e30a4
MODEL_HASH_SCALER=36bf4eb1c7e97213f0fa95bcddf0c069c425105bddfd2e4d8bc604f8b8d95a45

# ── Flask (local development only) ───────────────────────────────────────────
# FLASK_DEBUG defaults to False — never set True in production (SEC-5).
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5001

# Optional local SSL (if you have mkcert certs):
# SSL_CERT_PATH=localhost.pem
# SSL_KEY_PATH=localhost-key.pem
